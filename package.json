{
  "name": "rovalra",
  "version": "2.7",
  "description": "An extension aiming to provide features that other Roblox extensions pay wall!",
  "private": true,
  "scripts": {
    "build": "npm run clean && node build.js && node scripts/build-firefox.js",
    "build:chrome": "npm run clean && node build.js",
    "clean": "rimraf dist dist-firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "package:firefox": "web-ext build --source-dir dist-firefox --artifacts-dir build --overwrite-dest",
    "start:firefox": "web-ext run --source-dir dist-firefox --start-url https://www.roblox.com",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/three": "^0.186.0",
    "chrome-types": "^0.1.458",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1",
    "web-ext": "^10.8.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "i18next": "26.5.5",
    "marked": "^18.1.1",
    "roavatar-renderer": "^1.10.0",
    "roblox-bat": "0.6.5"
  },
  "overrides": {
    "brace-expansion": "^2.0.1",
    "flatted": "^3.3.2",
    "lodash": "^4.17.21",
    "minimatch": "^9.0.5",
    "picomatch": "^4.0.2",
    "multimatch": {
      "minimatch": "^3.1.2"
    }
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,json,css,md}": "prettier --write"
  }
}